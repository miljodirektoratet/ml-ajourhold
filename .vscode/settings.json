// Local VS Code Extension Configurations
// Not used by Devcontainer instead configs are listed in .devcontainer/devcontainer.json
{
  "files.associations": {
    "**/CODEOWNERS": "plaintext"
  },

  // Terminal
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.defaultProfile.linux": "Bash",

  // Profiles, Editors, and Themes
  "editor.rulers": [
    { "column": 88, "color": "#737171" },
  ],
  "editor.tabSize": 2,
  "workbench.colorCustomizations": {
    "activityBar.background": "#181818",
    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#cccccc"
  },

  // Python formatting
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
  },
  "autoDocstring.docstringFormat": "one-line-sphinx",

  // Python Environment settings
  // Python Environment settings
  "python.useEnvironmentsExtension": false,
  "python.terminal.activateEnvironment": true,
  // Pixi default
  // "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/gpu/python.exe",
  // UV default
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  // Conda ArcGIS Pro default
  //"python.defaultInterpreterPath": "${env:USERPROFILE}\\AppData\\Local\\ESRI\\conda\\envs\\arcgis-azure-v35\\python.exe",

  // Keep UV available for non-ArcPy scripts and Ruff.
  // Both the local UV .venv and ArcGIS Conda environments remain discoverable.
  // This default makes Pylance resolve ArcPy using the ArcGIS environment.
  // "python-envs.pythonProjects": [
  //   {
  //     "path": ".",
  //     "envManager": "ms-python.python:system",
  //     "packageManager": "ms-python.python:pip"
  //   }
  // ],

  // Ruff formatting
  "ruff.importStrategy": "useBundled",
  "ruff.interpreter": [
    ".venv/Scripts/python",
    ".venv/bin/python",
  ],

  // YAML formatting
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[yml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "prettier.printWidth": 88,
  "prettier.proseWrap": "always",

  // TOML formatting
  "[toml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "evenBetterToml.formatter.allowedBlankLines": 2,

  // Markdown formatting
  "[markdown]":{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Markdown Table of Contents settings
  "markdown.extension.toc.levels": "2..2",
  "markdown.extension.toc.updateOnSave": true,

  // Git
  "git.branchProtection": ["main"],
  "git.allowNoVerifyCommit": true,
  "git.confirmNoVerifyCommit": false,

  // Docker
  "containers.contexts.showInStatusBar": true,

  // PlantUML - choose local (java and must be installed) or server
  // "plantuml.render": "Local",

  "[plaintext]": {
    "editor.formatOnSave": false
  },
}
